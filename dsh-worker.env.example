# DSH Sync Worker 配置模板
# 复制为 dsh-worker.env 后填入真实值；该文件含密钥，切勿提交到仓库。
# 部署在**本地 DSH 机器**上，systemd 用法：EnvironmentFile=/opt/dsh-sync/dsh-worker.env

# ---------- 云端连接 ----------
# 指向 dsh-sync 服务的地址（上公网时用 https 域名）
DSH_SYNC_CLOUD=http://127.0.0.1:8090

# 节点标识，需与云端 workers 表里的 id 一致
DSH_SYNC_WORKER_ID=local-node

# Worker 令牌：云端注册该节点时生成，务必与云端一致
# 注册方式见 README「部署」一节
DSH_SYNC_WORKER_TOKEN=请替换为worker令牌

# ---------- DSH 位置 ----------
DSH_SYNC_CLI=/home/USER/deepseek-harness/apps/cli/lib/bin.js
DSH_SYNC_NODE=/usr/bin/node
DSH_SYNC_WORKER_PROFILE=headless

# ---------- 执行策略 ----------
# 允许作为工作目录的根（逗号分隔）。**安全关键项**：
# 任务以当前用户身份执行，拥有该用户全部文件权限，务必收紧到专用目录。
DSH_SYNC_WORKER_ROOTS=/home/USER

# 单机并发数
DSH_SYNC_WORKER_CONCURRENCY=1
# 轮询间隔（毫秒）
DSH_SYNC_WORKER_POLL_MS=3000
# 任务租约（秒）：执行期间 worker 会定时续租，超时未续租则任务被回收重排
DSH_SYNC_WORKER_LEASE_SECONDS=120
# 单次执行硬超时（毫秒）
DSH_SYNC_WORKER_TIMEOUT_MS=900000
# 透传给 DSH 子进程的环境变量白名单（模型凭据等）
DSH_SYNC_WORKER_ENV=NEW_API_API_KEY,PATH,HOME
DSH_SYNC_WORKER_VERBOSE=false

# ---------- 模型凭据 ----------
# 供 headless 子进程使用；也可改用 ~/.dsh/.credentials.yaml
NEW_API_API_KEY=请替换为模型密钥
