# DSH Sync 服务端配置模板
# 复制为 dsh-sync.env 后填入真实值；该文件含密钥，切勿提交到仓库。
# systemd 用法：EnvironmentFile=/opt/dsh-sync/dsh-sync.env

# ---------- 基础 ----------
DSH_SYNC_PORT=8090
DSH_SYNC_HOST=0.0.0.0

# 对外可访问的基地址，用于拼接邮件里的链接。
# 上公网时务必改成 https 域名，例如 https://dsh-sync.example.com
DSH_SYNC_PUBLIC_URL=http://localhost:8090

# 数据目录（SQLite、签名密钥）
DSH_SYNC_DATA_DIR=/opt/dsh-sync/data

# ---------- 鉴权 ----------
# 插件推送密钥：本地 DSH 插件的 config.token 必须与此一致。
# 生成：openssl rand -hex 24
DSH_SYNC_INGEST_TOKEN=请替换为随机串

# 分享链接签名密钥；留空则自动生成并落盘到 data/share.secret
# DSH_SYNC_SHARE_SECRET=

# 分享链接有效期（天），0 表示永不过期
DSH_SYNC_SHARE_TTL_DAYS=30

# ---------- 邮件通知 ----------
DSH_SYNC_MAIL_ENABLED=true
DSH_SYNC_SMTP_HOST=smtp.example.com
DSH_SYNC_SMTP_PORT=465
DSH_SYNC_SMTP_SECURE=true
DSH_SYNC_SMTP_USER=you@example.com
# 注意：多数邮箱需要的是「授权码」而非登录密码
DSH_SYNC_SMTP_PASS=请替换为授权码
DSH_SYNC_SMTP_FROM=you@example.com

# 兜底收件人（当用户未配置通知邮箱时使用）
DSH_SYNC_NOTIFY_TO=

# ---------- 网页端发起对话 ----------
DSH_SYNC_TASK_ENABLED=true
# 单用户同时未完成的任务上限
DSH_SYNC_TASK_PER_USER=2
# 提示词长度上限
DSH_SYNC_TASK_MAX_PROMPT=8000
# 任务超时（毫秒），与 worker 侧保持一致
DSH_SYNC_TASK_TIMEOUT_MS=600000
